# Runtime only. Never commit a filled copy.
SOURCE_SSH_HOST=hosting.example.org
SOURCE_SSH_PORT=22
SOURCE_SSH_USER=hostinguser
SOURCE_SHOP_PATH=/usr/www/users/hostinguser/shop
# In Coolify, paste these as multiline secret values, without wrapping quotes.
SOURCE_SSH_PRIVATE_KEY=
# Verified known_hosts entry; custom ports use [host]:port.
SOURCE_SSH_KNOWN_HOSTS=
# Used by the later import, not needed for --detect-source.
SOURCE_URL=https://www.example.org
